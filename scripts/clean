. config/options "${1}"

clean_package() {
  build_msg "CLR_CLEAN" "CLEAN" "${1}" "indent"

  if [ "${CLEAN_SOURCES}" = "true" ]; then
    rm -rf "${SOURCES}/${1}"
    return
  fi

  # Use a wildcard here to remove all versions of the package
  for i in "${BUILD}/build/${1}-"* \
    "${BUILD}/install_pkg/${1}-"* \
    "${BUILD}/install_init/${1}-"*; do
    if [ -d "${i}" -a -f "${i}/.rocknix-unpack" ]; then
      . "${i}/.rocknix-unpack"
      if [ "${STAMP_PKG_NAME}" = "${1}" ]; then
        build_msg "CLR_WARNING" "*" "$(print_color "CLR_WARNING_DIM" "Removing ${i} ...")"
        # A firmware extraction worker can finish creating files just after an
        # initial recursive delete has walked the directory. Retry the generated
        # package cache a few times instead of failing the whole image build.
        for attempt in 1 2 3; do
          rm -rf "${i}" && break
          [ "${attempt}" = 3 ] || sleep 1
        done
        [ ! -e "${i}" ] || exit 1
      fi
    elif [ -d "${i}" -a -f "${i}/.rocknix-package" ]; then
      # force clean if no stamp found (previous unpack failed)
      . "${i}/.rocknix-package"
      if [ "${INFO_PKG_NAME}" = "${1}" ]; then
        build_msg "CLR_WARNING" "*" "$(print_color "CLR_WARNING_DIM" "Removing ${i} ...")"
        for attempt in 1 2 3; do
          rm -rf "${i}" && break
          [ "${attempt}" = 3 ] || sleep 1
        done
        [ ! -e "${i}" ] || exit 1
      fi
    fi
  done

  for i in "${BUILD}/qa_checks/${1}-"*; do
    build_msg "CLR_WARNING" "*" "$(print_color "CLR_WARNING_DIM" "Removing ${i} ...")"
    rm -rf "${i}"
  done

  rm -f "${STAMPS}/${1}/build_"*
}

if [ "${1}" = "--all" -a -n "${2}" ]; then
  for build_dir in $(ls -1d "${BUILD_ROOT}/${BUILD_BASE}."*); do
    load_build_config "${build_dir}" && "${SCRIPTS}/clean" "${2}"
  done
elif [ -n "${1}" ]; then
  clean_package "${1}"
fi

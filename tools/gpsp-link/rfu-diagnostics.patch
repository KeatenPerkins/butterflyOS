--- a/rfu.c
+++ b/rfu.c
@@ -163,6 +163,24 @@
 // The table is indexed by client_id
 static t_client_broadcast rfu_peer_bcst[MAX_RFU_PEERS];
 
+/* Experimental bounded error/teardown probes; no timing-policy changes. */
+static void butterfly_rfu_trace(const char *event, unsigned detail) {
+  static unsigned counts[6];
+  unsigned kind = !strcmp(event, "reset") ? 0 :
+                  !strcmp(event, "local-disconnect") ? 1 :
+                  !strcmp(event, "remote-disconnect") ? 2 :
+                  !strcmp(event, "peer-expired") ? 3 :
+                  !strcmp(event, "wait-disconnected") ? 4 : 5;
+  /* Log at most eight occurrences of each event per core process. */
+  if (counts[kind]++ >= 8) return;
+  fprintf(stderr, "[BF-RFU] event=%s ticks=%u state=%u com=%u cmd=%02x "
+          "detail=%u wait=%u response=%u host=%u client=%u\n",
+          event, (unsigned)cpu_ticks, (unsigned)rfu_state,
+          (unsigned)rfu_comstate, (unsigned)rfu_cmd, detail,
+          (unsigned)rfu_timeout_cycles, (unsigned)rfu_resp_timeout,
+          (unsigned)rfu_host.devid, (unsigned)rfu_client.devid);
+}
+
 // Constants used for the network protocol.
 

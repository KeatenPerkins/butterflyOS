+/* Close/standby commands only; no Pokemon payload data is logged. */
+static unsigned bf_close_count;
+static void bf_close_log(const char *event, unsigned peer, const u16 *packet) {
+  struct timespec now;
+  if (!packet || (packet[0] != 0x5FFF && packet[0] != 0x2FFE)) return;
+  if (bf_close_count >= 128) return;
+  bf_close_count++;
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  fprintf(stderr, "[BF-CLOSE] event=%s id=%u peer=%u cmd=%04x offset=%u queue=%u,%u states=%u,%u mono=%lld.%03ld ticks=%u\n",
+    event, (unsigned)netplay_client_id, peer, packet[0], serstate.poke.offset,
+    serstate.poke.peer[0].count, serstate.poke.peer[1].count,
+    serstate.poke.peer[0].state, serstate.poke.peer[1].state,
+    (long long)now.tv_sec, now.tv_nsec/1000000, (unsigned)cpu_ticks);
+}
+
 // Serial-Poke: emulates (via fakes) the pokemon serial protocol.
 //
 // The protocol has two phases: handshake and data exchange.

+/* Bounded observational logging; counters survive serial resets. */
+static unsigned bf_counts[7];
+static void bf_cable_log(unsigned kind, const char *event, unsigned peer, unsigned detail) {
+  if (bf_counts[kind]++ >= 48) return;
+  fprintf(stderr, "[BF-CABLE] event=%s id=%u peer=%u detail=%u state=%u,%u,%u,%u queue=%u,%u,%u,%u offset=%u checksum=%u hscnt=%u ticks=%u\n",
+    event, (unsigned)netplay_client_id, peer, detail,
+    serstate.poke.peer[0].state, serstate.poke.peer[1].state,
+    serstate.poke.peer[2].state, serstate.poke.peer[3].state,
+    serstate.poke.peer[0].count, serstate.poke.peer[1].count,
+    serstate.poke.peer[2].count, serstate.poke.peer[3].count,
+    serstate.poke.offset, serstate.poke.checksum, serstate.poke.hscnt, (unsigned)cpu_ticks);
+}
+

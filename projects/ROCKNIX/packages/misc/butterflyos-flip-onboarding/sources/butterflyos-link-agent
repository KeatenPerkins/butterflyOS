"""Read-only LAN discovery and compatibility service for Butterfly Link."""

import argparse
import hashlib
import json
import os
import socket
import socketserver
import sys
import threading
import time

PROTOCOL = 1
UDP_PORT = int(os.environ.get("BUTTERFLY_LINK_DISCOVERY_PORT", "41110"))
TCP_PORT = int(os.environ.get("BUTTERFLY_LINK_CONTROL_PORT", "41111"))
CORE = os.environ.get(
    "BUTTERFLY_LINK_CORE", "/usr/lib/libretro/sameboy_libretro.so"
)
MAX_REQUEST = 4096
DISCOVERY_PREFIX = "BUTTERFLY_LINK_DISCOVER"


def sha256_file(path):
    digest = hashlib.sha256()
    try:
        with open(path, "rb") as source:
            for block in iter(lambda: source.read(1024 * 1024), b""):
                digest.update(block)
    except OSError:
        return "unavailable"
    return digest.hexdigest()


def os_version():
    values = {}
    try:
        with open("/etc/os-release", encoding="utf-8") as source:
            for line in source:
                key, separator, value = line.rstrip().partition("=")
                if separator:
                    values[key] = value.strip('"')
    except OSError:
        pass
    return values.get("VERSION_ID") or values.get("BUILD_ID") or "unknown"


def local_status():
    return {
        "ok": True,
        "service": "butterfly-link",
        "protocol": PROTOCOL,
        "hostname": socket.gethostname(),
        "version": os_version(),
        "sameboy_sha256": sha256_file(CORE),
        "capabilities": ["discovery", "compatibility", "save-safety-v1"],
    }


def json_bytes(value):
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


class ControlHandler(socketserver.StreamRequestHandler):
    def handle(self):
        self.connection.settimeout(3)
        request = self.rfile.readline(MAX_REQUEST + 1)
        if len(request) > MAX_REQUEST:
            self.wfile.write(json_bytes({"ok": False, "error": "request-too-large"}))
            return
        try:
            payload = json.loads(request.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError):
            self.wfile.write(json_bytes({"ok": False, "error": "invalid-request"}))
            return
        if payload != {"action": "status", "protocol": PROTOCOL}:
            self.wfile.write(json_bytes({"ok": False, "error": "unsupported-action"}))
            return
        self.wfile.write(json_bytes(local_status()))


class ThreadedTCPServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    allow_reuse_address = True
    daemon_threads = True


def discovery_server(stop_event):
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind(("", UDP_PORT))
    sock.settimeout(1)
    while not stop_event.is_set():
        try:
            data, address = sock.recvfrom(1024)
        except socket.timeout:
            continue
        except OSError:
            break
        try:
            text = data.decode("ascii")
        except UnicodeDecodeError:
            continue
        parts = text.split()
        if len(parts) != 3 or parts[0] != DISCOVERY_PREFIX:
            continue
        try:
            requested_protocol = int(parts[1])
        except ValueError:
            continue
        if requested_protocol != PROTOCOL or len(parts[2]) > 64:
            continue
        response = local_status()
        response["nonce"] = parts[2]
        response["control_port"] = TCP_PORT
        try:
            sock.sendto(json_bytes(response), address)
        except OSError:
            pass
    sock.close()


def serve():
    stop_event = threading.Event()
    discovery = threading.Thread(target=discovery_server, args=(stop_event,), daemon=True)
    discovery.start()
    try:
        with ThreadedTCPServer(("", TCP_PORT), ControlHandler) as server:
            server.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        pass
    finally:
        stop_event.set()
        discovery.join(timeout=2)


def probe(host, port=TCP_PORT, timeout=3.0):
    with socket.create_connection((host, port), timeout=timeout) as connection:
        connection.settimeout(timeout)
        connection.sendall(json_bytes({"action": "status", "protocol": PROTOCOL}))
        response = b""
        while not response.endswith(b"\n") and len(response) <= MAX_REQUEST:
            block = connection.recv(1024)
            if not block:
                break
            response += block
    if len(response) > MAX_REQUEST:
        raise ValueError("response-too-large")
    payload = json.loads(response.decode("utf-8"))
    if not payload.get("ok") or payload.get("service") != "butterfly-link":
        raise ValueError(payload.get("error", "invalid-peer"))
    return payload


def discover(timeout):
    nonce = hashlib.sha256(f"{os.getpid()}:{time.time_ns()}".encode()).hexdigest()[:16]
    request = f"{DISCOVERY_PREFIX} {PROTOCOL} {nonce}".encode()
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    sock.settimeout(0.25)
    sock.bind(("", 0))
    for address in ("255.255.255.255",):
        try:
            sock.sendto(request, (address, UDP_PORT))
        except OSError:
            pass
    deadline = time.monotonic() + timeout
    peers = {}
    while time.monotonic() < deadline:
        try:
            data, address = sock.recvfrom(MAX_REQUEST)
        except socket.timeout:
            continue
        try:
            payload = json.loads(data.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError):
            continue
        if (
            payload.get("ok")
            and payload.get("service") == "butterfly-link"
            and payload.get("nonce") == nonce
            and payload.get("protocol") == PROTOCOL
        ):
            peers[address[0]] = payload
    sock.close()
    return peers


def compatibility(peer):
    local = local_status()
    reasons = []
    if peer.get("protocol") != local["protocol"]:
        reasons.append("protocol")
    if peer.get("sameboy_sha256") != local["sameboy_sha256"]:
        reasons.append("sameboy-core")
    return reasons


def print_peer(address, peer):
    reasons = compatibility(peer)
    print(
        "\t".join(
            [
                f"ip={address}",
                f"hostname={peer.get('hostname', 'unknown')}",
                f"version={peer.get('version', 'unknown')}",
                f"protocol={peer.get('protocol', 'unknown')}",
                f"core={peer.get('sameboy_sha256', 'unknown')}",
                f"compatible={'yes' if not reasons else 'no'}",
                f"reasons={','.join(reasons) if reasons else 'none'}",
            ]
        )
    )


def main():
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("serve")
    discover_parser = subparsers.add_parser("discover")
    discover_parser.add_argument("--timeout", type=float, default=3.0)
    probe_parser = subparsers.add_parser("probe")
    probe_parser.add_argument("host")
    probe_parser.add_argument("--port", type=int, default=TCP_PORT)
    status_parser = subparsers.add_parser("status")
    status_parser.add_argument("--json", action="store_true")
    arguments = parser.parse_args()

    if arguments.command == "serve":
        serve()
    elif arguments.command == "discover":
        peers = discover(arguments.timeout)
        for address in sorted(peers):
            print_peer(address, peers[address])
        if not peers:
            return 1
    elif arguments.command == "probe":
        try:
            peer = probe(arguments.host, arguments.port)
        except (OSError, ValueError, json.JSONDecodeError) as error:
            print(f"error={error}", file=sys.stderr)
            return 1
        print_peer(arguments.host, peer)
        return 0 if not compatibility(peer) else 3
    elif arguments.command == "status":
        status = local_status()
        if arguments.json:
            print(json.dumps(status, sort_keys=True))
        else:
            print_peer("local", status)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

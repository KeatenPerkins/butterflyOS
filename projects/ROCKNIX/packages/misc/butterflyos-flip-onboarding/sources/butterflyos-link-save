# Save-safety backend for Butterfly Link. This tool never launches an emulator;
# it creates verified working copies and is the only component allowed to write
# a completed session back to the user-selected save.

set -euo pipefail
umask 077

STORAGE_ROOT=${BUTTERFLY_LINK_STORAGE_ROOT:-/storage}
EXTERNAL_ROOT=${BUTTERFLY_LINK_EXTERNAL_ROOT:-${STORAGE_ROOT}/games-external}
INTERNAL_ROM_ROOT=${BUTTERFLY_LINK_INTERNAL_ROM_ROOT:-${STORAGE_ROOT}/roms}
RETROARCH_SAVE_ROOT=${BUTTERFLY_LINK_RETROARCH_SAVE_ROOT:-${STORAGE_ROOT}/.config/retroarch/saves}
STATE_ROOT=${BUTTERFLY_LINK_STATE_ROOT:-${STORAGE_ROOT}/.config/butterflyos/link}
SESSION_ROOT=${STATE_ROOT}/sessions
MAX_SAVE_BYTES=${BUTTERFLY_LINK_MAX_SAVE_BYTES:-8388608}

die() {
  printf 'error=%s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
Usage:
  butterflyos-link-save discover ROM
  butterflyos-link-save begin ROM SAVE
  butterflyos-link-save status SESSION_ID
  butterflyos-link-save commit SESSION_ID [WORKING_SAVE]
  butterflyos-link-save abort SESSION_ID
  butterflyos-link-save restore SESSION_ID
EOF
  exit 2
}

sha256_file() {
  sha256sum -- "$1" | awk '{print tolower($1)}'
}

file_size() {
  stat -c '%s' -- "$1"
}

canonical_file() {
  local path=${1:?}
  [[ -f "$path" ]] || die "not-a-regular-file:$path"
  readlink -f -- "$path" || die "cannot-resolve:$path"
}

encode() {
  printf '%s' "$1" | base64 | tr -d '\n'
}

decode() {
  printf '%s' "$1" | base64 -d
}

allowed_path() {
  local path=${1:?}
  case "$path" in
    "$INTERNAL_ROM_ROOT"/*|"$RETROARCH_SAVE_ROOT"/*|"$EXTERNAL_ROOT"/roms/*)
      return 0
      ;;
  esac
  return 1
}

validate_save() {
  local path size
  path=$(canonical_file "$1")
  allowed_path "$path" || die "save-outside-approved-storage:$path"
  case "${path,,}" in
    *.srm|*.sav) ;;
    *) die "unsupported-save-extension:$path" ;;
  esac
  size=$(file_size "$path")
  (( size > 0 )) || die "empty-save:$path"
  (( size <= MAX_SAVE_BYTES )) || die "save-too-large:$path"
  printf '%s\n' "$path"
}

validate_rom() {
  local path
  path=$(canonical_file "$1")
  allowed_path "$path" || die "rom-outside-approved-storage:$path"
  case "${path,,}" in
    *.gb|*.gbc) ;;
    *) die "unsupported-rom-extension:$path" ;;
  esac
  printf '%s\n' "$path"
}

session_dir() {
  local id=${1:?}
  [[ "$id" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+-[0-9]+$ ]] || die "invalid-session-id"
  printf '%s/%s\n' "$SESSION_ROOT" "$id"
}

manifest_value() {
  local manifest=${1:?} key=${2:?} value
  value=$(sed -n "s/^${key}=//p" "$manifest" | head -n 1)
  [[ -n "$value" ]] || die "manifest-missing:$key"
  printf '%s\n' "$value"
}

session_state() {
  local dir=${1:?}
  [[ -f "$dir/state" ]] || die "session-state-missing"
  tr -d '\r\n' <"$dir/state"
}

write_state() {
  local dir=${1:?} state=${2:?} tmp="$dir/.state.$$"
  printf '%s\n' "$state" >"$tmp"
  mv -f -- "$tmp" "$dir/state"
}

storage_identity() {
  findmnt -n -o SOURCE,UUID,LABEL -T "$1" 2>/dev/null | head -n 1 || true
}

atomic_replace() {
  local source=${1:?} target=${2:?} expected_sha=${3:?} target_mode=${4:?}
  local directory base temporary actual_sha
  directory=${target%/*}
  base=${target##*/}
  temporary="${directory}/.${base}.butterfly-link.$$.tmp"

  [[ -d "$directory" ]] || die "target-directory-missing:$directory"
  [[ ! -e "$temporary" ]] || die "temporary-path-exists:$temporary"
  cp -p -- "$source" "$temporary"
  chmod "$target_mode" "$temporary"
  actual_sha=$(sha256_file "$temporary")
  if [[ "$actual_sha" != "$expected_sha" ]]; then
    rm -f -- "$temporary"
    die "temporary-copy-verification-failed"
  fi
  sync -f "$temporary" 2>/dev/null || sync
  mv -f -- "$temporary" "$target"
  sync -f "$directory" 2>/dev/null || sync
  [[ "$(sha256_file "$target")" == "$expected_sha" ]] || die "writeback-verification-failed"
}

discover() {
  local selected_rom stem rom_dir search_root candidate canonical location rank
  local results temporary first=1
  declare -A seen=()

  selected_rom=$(validate_rom "${1:?}")
  stem=${selected_rom##*/}
  stem=${stem%.*}
  rom_dir=${selected_rom%/*}
  mkdir -p "$STATE_ROOT"
  temporary=$(mktemp "${STATE_ROOT}/discover.XXXXXX")
  trap 'rm -f -- "${temporary:-}"' EXIT

  for search_root in "$rom_dir" "$RETROARCH_SAVE_ROOT" "$INTERNAL_ROM_ROOT" "$EXTERNAL_ROOT/roms"; do
    [[ -d "$search_root" ]] || continue
    while IFS= read -r -d '' candidate; do
      canonical=$(readlink -f -- "$candidate" 2>/dev/null || true)
      [[ -n "$canonical" && -f "$canonical" ]] || continue
      [[ -z "${seen[$canonical]:-}" ]] || continue
      seen[$canonical]=1
      case "$canonical" in
        "$rom_dir"/*) rank=10 ;;
        "$RETROARCH_SAVE_ROOT"/*) rank=20 ;;
        "$INTERNAL_ROM_ROOT"/*) rank=30 ;;
        "$EXTERNAL_ROOT"/roms/*) rank=40 ;;
        *) continue ;;
      esac
      case "$canonical" in
        "$EXTERNAL_ROOT"/*) location=GAME_CARD ;;
        *) location=OS_CARD ;;
      esac
      printf '%s\t%s\t%s\t%s\t%s\n' "$rank" "$location" "$(file_size "$canonical")" \
        "$(sha256_file "$canonical")" "$canonical" >>"$temporary"
    done < <(find "$search_root" \( -type f -o -type l \) \( -name "$stem.srm" -o -name "$stem.sav" \) -print0 2>/dev/null)
  done

  if [[ ! -s "$temporary" ]]; then
    printf 'found=0\n'
    return 0
  fi

  while IFS=$'\t' read -r rank location size checksum candidate; do
    if (( first )); then
      printf 'selected=yes\tlocation=%s\tsize=%s\tsha256=%s\tpath=%s\n' \
        "$location" "$size" "$checksum" "$candidate"
      first=0
    else
      printf 'selected=no\tlocation=%s\tsize=%s\tsha256=%s\tpath=%s\n' \
        "$location" "$size" "$checksum" "$candidate"
    fi
  done < <(sort -n -k1,1 "$temporary")
}

begin_session() {
  local selected_rom selected_save id dir backup working manifest
  local rom_sha save_sha save_size save_mode identity

  selected_rom=$(validate_rom "${1:?}")
  selected_save=$(validate_save "${2:?}")
  mkdir -p "$SESSION_ROOT"
  id="$(date -u '+%Y%m%dT%H%M%SZ')-$$-${RANDOM}"
  dir=$(session_dir "$id")
  mkdir "$dir"
  backup="$dir/original-save"
  working="$dir/working-save"
  manifest="$dir/manifest"

  rom_sha=$(sha256_file "$selected_rom")
  save_sha=$(sha256_file "$selected_save")
  save_size=$(file_size "$selected_save")
  save_mode=$(stat -c '%a' -- "$selected_save")
  identity=$(storage_identity "$selected_save")

  cp -p -- "$selected_save" "$backup"
  cp -p -- "$selected_save" "$working"
  chmod 0400 "$backup"
  [[ "$(sha256_file "$backup")" == "$save_sha" ]] || die "backup-verification-failed"
  [[ "$(sha256_file "$working")" == "$save_sha" ]] || die "working-copy-verification-failed"

  {
    printf 'format=1\n'
    printf 'session_id=%s\n' "$id"
    printf 'created_utc=%s\n' "$(date -u '+%FT%TZ')"
    printf 'rom_path_b64=%s\n' "$(encode "$selected_rom")"
    printf 'rom_sha256=%s\n' "$rom_sha"
    printf 'original_path_b64=%s\n' "$(encode "$selected_save")"
    printf 'original_selected_path_b64=%s\n' "$(encode "${2}")"
    printf 'original_sha256=%s\n' "$save_sha"
    printf 'original_size=%s\n' "$save_size"
    printf 'original_mode=%s\n' "$save_mode"
    printf 'storage_identity_b64=%s\n' "$(encode "$identity")"
  } >"$manifest"
  chmod 0400 "$manifest"
  write_state "$dir" ACTIVE
  sync -f "$backup" 2>/dev/null || sync

  printf 'session_id=%s\n' "$id"
  printf 'working_save=%s\n' "$working"
  printf 'backup=%s\n' "$backup"
  printf 'original=%s\n' "$selected_save"
}

show_status() {
  local dir manifest state original
  dir=$(session_dir "${1:?}")
  manifest="$dir/manifest"
  [[ -f "$manifest" ]] || die "session-not-found"
  state=$(session_state "$dir")
  original=$(decode "$(manifest_value "$manifest" original_path_b64)")
  printf 'session_id=%s\n' "${1}"
  printf 'state=%s\n' "$state"
  printf 'original=%s\n' "$original"
  printf 'backup=%s\n' "$dir/original-save"
  printf 'working_save=%s\n' "$dir/working-save"
  printf 'original_sha256=%s\n' "$(manifest_value "$manifest" original_sha256)"
  if [[ -f "$dir/working-save" ]]; then
    printf 'working_sha256=%s\n' "$(sha256_file "$dir/working-save")"
  fi
}

commit_session() {
  local dir manifest state original original_sha original_size original_mode working
  local current_sha working_sha working_size result
  dir=$(session_dir "${1:?}")
  manifest="$dir/manifest"
  [[ -f "$manifest" ]] || die "session-not-found"
  state=$(session_state "$dir")
  [[ "$state" == ACTIVE ]] || die "session-not-active:$state"
  original=$(decode "$(manifest_value "$manifest" original_path_b64)")
  original_sha=$(manifest_value "$manifest" original_sha256)
  original_size=$(manifest_value "$manifest" original_size)
  original_mode=$(manifest_value "$manifest" original_mode)
  working=${2:-$dir/working-save}
  working=$(canonical_file "$working")
  case "$working" in
    "$dir"/*) ;;
    *) allowed_path "$working" || die "working-save-outside-approved-storage" ;;
  esac

  [[ -f "$original" ]] || die "original-save-missing"
  current_sha=$(sha256_file "$original")
  [[ "$current_sha" == "$original_sha" ]] || die "original-save-changed-during-session"
  working_size=$(file_size "$working")
  (( working_size > 0 && working_size <= MAX_SAVE_BYTES )) || die "invalid-working-save-size"
  [[ "$working_size" == "$original_size" ]] || die "working-save-size-changed"
  working_sha=$(sha256_file "$working")

  atomic_replace "$working" "$original" "$working_sha" "$original_mode"
  result="$dir/committed-save"
  cp -p -- "$original" "$result"
  [[ "$(sha256_file "$result")" == "$working_sha" ]] || die "result-archive-verification-failed"
  write_state "$dir" COMMITTED
  printf 'state=COMMITTED\n'
  printf 'original=%s\n' "$original"
  printf 'before_sha256=%s\n' "$original_sha"
  printf 'after_sha256=%s\n' "$working_sha"
}

abort_session() {
  local dir state
  dir=$(session_dir "${1:?}")
  state=$(session_state "$dir")
  [[ "$state" == ACTIVE ]] || die "session-not-active:$state"
  write_state "$dir" ABORTED
  printf 'state=ABORTED\n'
  printf 'original_unchanged=yes\n'
}

restore_session() {
  local dir manifest backup original expected current_archive expected_size original_mode
  dir=$(session_dir "${1:?}")
  manifest="$dir/manifest"
  backup="$dir/original-save"
  [[ -f "$manifest" && -f "$backup" ]] || die "session-backup-missing"
  original=$(decode "$(manifest_value "$manifest" original_path_b64)")
  expected=$(manifest_value "$manifest" original_sha256)
  expected_size=$(manifest_value "$manifest" original_size)
  original_mode=$(manifest_value "$manifest" original_mode)
  [[ "$(file_size "$backup")" == "$expected_size" ]] || die "backup-size-mismatch"
  [[ "$(sha256_file "$backup")" == "$expected" ]] || die "backup-checksum-mismatch"
  allowed_path "$original" || die "restore-target-outside-approved-storage"

  if [[ -f "$original" ]]; then
    current_archive="$dir/pre-restore-$(date -u '+%Y%m%dT%H%M%SZ')"
    cp -p -- "$original" "$current_archive"
  fi
  atomic_replace "$backup" "$original" "$expected" "$original_mode"
  write_state "$dir" RESTORED
  printf 'state=RESTORED\n'
  printf 'original=%s\n' "$original"
  printf 'restored_sha256=%s\n' "$expected"
}

command=${1:-}
case "$command" in
  discover) [[ $# -eq 2 ]] || usage; discover "$2" ;;
  begin) [[ $# -eq 3 ]] || usage; begin_session "$2" "$3" ;;
  status) [[ $# -eq 2 ]] || usage; show_status "$2" ;;
  commit) [[ $# -ge 2 && $# -le 3 ]] || usage; commit_session "$2" "${3:-}" ;;
  abort) [[ $# -eq 2 ]] || usage; abort_session "$2" ;;
  restore) [[ $# -eq 2 ]] || usage; restore_session "$2" ;;
  *) usage ;;
esac

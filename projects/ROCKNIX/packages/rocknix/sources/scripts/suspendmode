#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2024-present ROCKNIX (https://github.com/ROCKNIX)

. /etc/profile

REQUESTED_MODE="${*}"
SUSPEND_MODE=$(get_setting system.suspendmode)

# The Miyoo Flip V2 can lose mmc0 while resuming from deep suspend, aborting
# the /storage journal. ButterflyOS keeps suspend disabled until a proven-safe
# display-only implementation replaces it. Enforce the policy below the GUI so
# stale settings and direct command-line requests cannot re-enable mem mode.
if [ -d /usr/share/butterflyos ] && \
   grep -qa "Miyoo Flip" /proc/device-tree/model 2>/dev/null; then
  REQUESTED_MODE=off
  set -- off
fi

if [ ! "${REQUESTED_MODE}" = "${SUSPEND_MODE}" ]; then
  cat <<EOF >/storage/.config/sleep.conf.d/sleep.conf
[Sleep]
EOF
  case ${REQUESTED_MODE} in
    off)
      cat <<EOF >>/storage/.config/sleep.conf.d/sleep.conf
AllowSuspend=no
EOF
      ;;
    freeze)
      cat <<EOF >>/storage/.config/sleep.conf.d/sleep.conf
AllowSuspend=yes
SuspendState=freeze standby mem
EOF
      ;;
    standby)
      cat <<EOF >>/storage/.config/sleep.conf.d/sleep.conf
AllowSuspend=yes
SuspendState=standby mem freeze
EOF
      ;;
    mem)
      cat <<EOF >>/storage/.config/sleep.conf.d/sleep.conf
AllowSuspend=yes
SuspendState=mem standby freeze
EOF
      ;;
    default)
      del_setting system.suspendmode
      if [ -e "/usr/lib/autostart/quirks/devices/${QUIRK_DEVICE}/030-suspend_mode" ]; then
        "/usr/lib/autostart/quirks/devices/${QUIRK_DEVICE}/030-suspend_mode"
      elif [ -e "/usr/lib/autostart/quirks/platforms/${HW_DEVICE}/030-suspend_mode" ]; then
        "/usr/lib/autostart/quirks/platforms/${HW_DEVICE}/030-suspend_mode"
      fi
      ;;
    *)
      cat <<EOF >>/storage/.config/sleep.conf.d/sleep.conf
AllowSuspend=yes
SuspendState=${REQUESTED_MODE}
EOF
      ;;
  esac
  set_setting system.suspendmode ${1}
  systemctl restart systemd-logind
fi

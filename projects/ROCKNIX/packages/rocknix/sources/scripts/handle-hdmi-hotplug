#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2025 ROCKNIX (https://github.com/ROCKNIX)

. /etc/profile
if ! pgrep -x emulationstation > /dev/null; then
  exit 0
fi

HDMI_OUTPUT=$(wlr-randr | awk '/^(HDMI-A|DP|DisplayPort)-[0-9]*/ {print $1}')
DSI_OUTPUT=$(wlr-randr | awk '/^DSI-[0-9]/ {print $1}')

HDMI_STATE=$(cat /run/hdmi-status.last 2>/dev/null)

restart_emulationstation() {
  # Request a normal exit first so scraped metadata and gamelists are written.
  # Older builds used killall directly; SIGTERM bypasses ES's normal shutdown
  # path and can discard everything scraped since its last clean exit.
  wget -q -O /dev/null http://127.0.0.1:1234/quit 2>/dev/null || true
  timeout=10
  while pgrep -x emulationstation >/dev/null && [ "${timeout}" -gt 0 ]; do
    sleep 1
    timeout=$((timeout - 1))
  done
  if pgrep -x emulationstation >/dev/null; then
    killall emulationstation
  fi
}

# Sway owns the frontend through essway.service.  A concurrently active
# emustation.service competes for EGL and can restart-loop indefinitely.
case " ${UI_SERVICE} " in
  *" essway.service "*) systemctl stop emustation.service ;;
esac

case "${HDMI_STATE}" in
  connected)

    # Stop USB gadget only if using USB-C (DisplayPort) video, as it conflicts with USB data lanes on some SoCs (e.g. RK3588/SM8250)
    # Standard HDMI ports are unaffected.
    if cat /sys/class/drm/card*-DP*/status /sys/class/drm/card*-DisplayPort*/status 2>/dev/null | grep -q "^connected"; then
        if systemctl is-active --quiet usbgadget; then
             systemctl stop usbgadget
        fi
    fi
    if [ -n "${HDMI_OUTPUT}" ]; then
      wlr-randr --output "${HDMI_OUTPUT}" --preferred --on
    fi
    if [ -n "${DSI_OUTPUT}" ]; then
      wlr-randr --output "${DSI_OUTPUT}" --off
    fi
    restart_emulationstation
    ;;
  disconnected)

    # Stop USB gadget only if using USB-C (DisplayPort) video, as it conflicts with USB data lanes on some SoCs (e.g. RK3588/SM8250)
    # Standard HDMI ports are unaffected.
    if cat /sys/class/drm/card*-DP*/status /sys/class/drm/card*-DisplayPort*/status 2>/dev/null | grep -q "^connected"; then
        if systemctl is-active --quiet usbgadget; then
             systemctl stop usbgadget
        fi
    fi
    if [ -n "${DSI_OUTPUT}" ]; then
      wlr-randr --output "${DSI_OUTPUT}" --preferred --on
    fi
    restart_emulationstation
    ;;
esac

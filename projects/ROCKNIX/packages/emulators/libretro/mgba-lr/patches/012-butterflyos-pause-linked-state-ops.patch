+struct LinkThreadPauseGuard {
+	bool interrupted[2];
+};
+
+static void _linkPauseBothThreads(struct LinkThreadPauseGuard* guard) {
+	memset(guard, 0, sizeof(*guard));
+	if (!linkThreadsStarted) {
+		return;
+	}
+
+	/* mCoreThreadInterrupt cannot observe a worker blocked in our custom
+	 * frame callback. Release only workers already parked there, then clear
+	 * the frontend's held-frame bookkeeping before requesting native mGBA
+	 * interrupts. A released worker can help its lockstep peer reach the
+	 * mCoreThread loop while the first interrupt is acknowledged. */
+	MutexLock(&linkFrameMutex);
+	if (linkFrameDone[0]) {
+		linkFrameRelease[0] = true;
+	}
+	if (linkFrameDone[1]) {
+		linkFrameRelease[1] = true;
+	}
+	ConditionWake(&linkFrameCondition);
+	linkFrameHeld = false;
+	MutexUnlock(&linkFrameMutex);
+
+	mCoreThreadInterrupt(&linkThreads[0]);
+	guard->interrupted[0] = true;
+	mCoreThreadInterrupt(&linkThreads[1]);
+	guard->interrupted[1] = true;
+	if (logCallback) {
+		logCallback(RETRO_LOG_INFO, "[BFLink] thread-pause guard begin interrupted0=%d interrupted1=%d\n",
+		           guard->interrupted[0], guard->interrupted[1]);
+	}
+}
+
+static void _linkResumeBothThreads(struct LinkThreadPauseGuard* guard) {
+	if (!guard->interrupted[0] && !guard->interrupted[1]) {
+		return;
+	}
+	/* Resume the secondary first so the primary lockstep coordinator never
+	 * starts a transfer while its peer is still interrupted. */
+	if (guard->interrupted[1]) {
+		mCoreThreadContinue(&linkThreads[1]);
+		guard->interrupted[1] = false;
+	}
+	if (guard->interrupted[0]) {
+		mCoreThreadContinue(&linkThreads[0]);
+		guard->interrupted[0] = false;
+	}
+	if (logCallback) {
+		logCallback(RETRO_LOG_INFO, "[BFLink] thread-pause guard end\n");
+	}
+}

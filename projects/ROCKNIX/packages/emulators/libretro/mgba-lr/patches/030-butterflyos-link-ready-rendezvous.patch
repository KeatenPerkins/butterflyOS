+      }
       link->localWord = link->d.p->p->memory.io[GBA_REG(SIOMLT_SEND)];
     }
+    uint16_t previousRemoteWord = link->remoteWord;
     link->remoteWord = ntohs(packet.word);
     link->remoteSequence = sequence;
     link->haveRemoteSequence = true;
-    if (link->playerId != 0) _queue(link, sequence, link->localWord);
+    if (link->playerId != 0 &&
+        (!link->transferPending || previousRemoteWord != link->remoteWord ||
+         link->localWord != link->d.p->p->memory.io[GBA_REG(SIOMLT_SEND)])) {
+      link->localWord = link->d.p->p->memory.io[GBA_REG(SIOMLT_SEND)];
+      _queue(link, sequence, link->localWord);
+    }
     if (_diagnostic(link, BF_POLL)) mLOG(GBA_SIO, INFO,
         "BF poll p=%u f=%u n=%u peer=%u seq=%u word=%04X local=%04X reply=%u",

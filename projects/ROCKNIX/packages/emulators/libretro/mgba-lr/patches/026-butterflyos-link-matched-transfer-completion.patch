+static bool _flush(struct GBASIOButterfly* link) {
+  while (link->connected && link->txOffset < link->txSize) {
+    ssize_t sent = send(link->socket, link->txBuffer + link->txOffset,
+        link->txSize - link->txOffset, MSG_NOSIGNAL);

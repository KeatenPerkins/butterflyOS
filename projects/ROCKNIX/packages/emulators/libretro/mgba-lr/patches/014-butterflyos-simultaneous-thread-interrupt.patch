+bool mCoreThreadInterruptRequest(struct mCoreThread* threadContext) {
+	if (!threadContext || !threadContext->impl) {
+		return false;
+	}
+	MutexLock(&threadContext->impl->stateMutex);
+	++threadContext->impl->interruptDepth;
+	if (threadContext->impl->interruptDepth > 1) {
+		MutexUnlock(&threadContext->impl->stateMutex);
+		return true;
+	}
+	if (threadContext->impl->state < mTHREAD_RUNNING ||
+	    threadContext->impl->state >= mTHREAD_EXITING ||
+	    threadContext->impl->state == mTHREAD_CRASHED) {
+		--threadContext->impl->interruptDepth;
+		MutexUnlock(&threadContext->impl->stateMutex);
+		return false;
+	}
+	threadContext->impl->state = mTHREAD_INTERRUPTING;
+	ConditionWake(&threadContext->impl->stateOnThreadCond);
+	MutexUnlock(&threadContext->impl->stateMutex);
+	return true;
+}
+
+bool mCoreThreadInterruptWait(struct mCoreThread* threadContext) {
+	if (!threadContext || !threadContext->impl) {
+		return false;
+	}
+	MutexLock(&threadContext->impl->stateMutex);
+	if (threadContext->impl->interruptDepth < 1) {
+		MutexUnlock(&threadContext->impl->stateMutex);
+		return false;
+	}
+	_waitUntilNotState(threadContext->impl, mTHREAD_INTERRUPTING);
+	bool interrupted = threadContext->impl->state == mTHREAD_INTERRUPTED;
+	MutexUnlock(&threadContext->impl->stateMutex);
+	return interrupted;
+}

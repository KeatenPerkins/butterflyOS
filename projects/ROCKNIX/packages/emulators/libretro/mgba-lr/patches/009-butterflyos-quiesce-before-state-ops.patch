+static bool _linkQuiesceBoth(void) {
+	/* Park both persistent linked core threads at a frame boundary before a
+	 * frontend-side state op (retro_serialize/retro_unserialize/size), which
+	 * can otherwise race a worker still mid-frame. _linkWaitForFrame only
+	 * waits for player 0, so player 1 could still be running when the
+	 * frontend captures/restores state; the captured GDB trace had a worker
+	 * abort in GBASIOLockstepDriverSetMode while the frontend was inside
+	 * retro_serialize -> GBASIOLockstepDriverSaveState. A thread sets
+	 * linkFrameDone[player] in _linkFrameEnded and then blocks on its release
+	 * flag, so a true linkFrameDone[player] means that thread is quiescent.
+	 * The bound is a counted 4 x 50 ms deadline: attempts advances on every
+	 * bounded wait (timeout OR early wake) so a half-parked state spamming
+	 * wakes cannot exceed the bound; the predicate is re-checked after
+	 * every wake. On failure (timeout or stopping), any worker that already
+	 * parked is released and both release flags are pre-armed so a worker
+	 * that parks later finds its flag set and does not linger -- otherwise a
+	 * timed-out quiesce could strand a parked worker the next retro_run
+	 * (linkFrameHeld still false) would never release. The caller sets
+	 * linkFrameHeld after a successful park so the next retro_run advances
+	 * a fresh frame. Bounded so a wedged session fails the op rather than
+	 * hangs, honoring the interruptible wait. */
+	if (!linkThreadsStarted) {
+		return true;
+	}
+	MutexLock(&linkFrameMutex);
+	unsigned attempts = 0;
+	bool parked = linkFrameDone[0] && linkFrameDone[1];
+	while (!parked && !linkThreadsStopping && attempts < 4) {
+		ConditionWaitTimed(&linkFrameCondition, &linkFrameMutex, 50);
+		++attempts;
+		parked = linkFrameDone[0] && linkFrameDone[1];
+	}
+	bool quiescent = parked && !linkThreadsStopping;
+	if (!quiescent) {
+		linkFrameRelease[0] = true;
+		linkFrameRelease[1] = true;
+		ConditionWake(&linkFrameCondition);
+	}
+	MutexUnlock(&linkFrameMutex);
+	return quiescent;
+}
 

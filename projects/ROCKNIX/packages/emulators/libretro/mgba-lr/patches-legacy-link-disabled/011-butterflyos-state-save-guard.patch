+struct LinkStateSaveGuard {
+	struct mLockstepUser saveUsers[2];
+	struct mLockstepUser* activeUsers[2];
+	bool transferActive;
+	uint32_t waiting;
+	bool active;
+};
+
+static void _linkStateSaveBegin(struct LinkStateSaveGuard* guard) {
+	memset(guard, 0, sizeof(*guard));
+	guard->saveUsers[0].sleep = _linkRestoreUserSleep;
+	guard->saveUsers[0].wake = _linkRestoreUserWake;
+	guard->saveUsers[1].sleep = _linkRestoreUserSleep;
+	guard->saveUsers[1].wake = _linkRestoreUserWake;
+	MutexLock(&linkCoordinator.mutex);
+	guard->activeUsers[0] = linkDrivers[0].user;
+	guard->activeUsers[1] = linkDrivers[1].user;
+	guard->transferActive = linkCoordinator.transferActive;
+	guard->waiting = linkCoordinator.waiting;
+	linkDrivers[0].user = &guard->saveUsers[0];
+	linkDrivers[1].user = &guard->saveUsers[1];
+	linkCoordinator.transferActive = false;
+	linkCoordinator.waiting = 0;
+	guard->active = true;
+	MutexUnlock(&linkCoordinator.mutex);
+	if (logCallback) {
+		logCallback(RETRO_LOG_INFO, "[BFLink] state-save guard begin transferActive=%d waiting=%u\n",
+		           (int)guard->transferActive, guard->waiting);
+	}
+}
+
+static void _linkStateSaveEnd(struct LinkStateSaveGuard* guard) {
+	if (!guard->active) {
+		return;
+	}
+	MutexLock(&linkCoordinator.mutex);
+	linkCoordinator.transferActive = guard->transferActive;
+	linkCoordinator.waiting = guard->waiting;
+	linkDrivers[0].user = guard->activeUsers[0];
+	linkDrivers[1].user = guard->activeUsers[1];
+	guard->active = false;
+	MutexUnlock(&linkCoordinator.mutex);
+	if (logCallback) {
+		logCallback(RETRO_LOG_INFO, "[BFLink] state-save guard end\n");
+	}
+}

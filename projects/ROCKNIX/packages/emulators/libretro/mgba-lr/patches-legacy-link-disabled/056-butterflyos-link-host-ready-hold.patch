--- a/src/gba/sio/butterfly.c
+++ b/src/gba/sio/butterfly.c
@@ -173,5 +173,7 @@
-static bool _needsReadyRendezvous(uint16_t localWord, uint16_t remoteWord) {
-  /* Do not expose a one-frame 8FFF/B9A0 mismatch to Pokémon.  The cable
-   * handshake is simultaneous: keep the transfer pending until both games
-   * have published the ready word. */
+static bool _needsReadyRendezvous(struct GBASIOButterfly* link,
+    uint16_t localWord, uint16_t remoteWord) {
+  /* The guest must complete so its game can process the host's word and
+   * update SIOMLT_SEND. Only the host holds a mismatched ready transfer. */
+  if (link->playerId != 0) return false;
+  return (localWord == BF_READY_WORD) != (remoteWord == BF_READY_WORD);
 }

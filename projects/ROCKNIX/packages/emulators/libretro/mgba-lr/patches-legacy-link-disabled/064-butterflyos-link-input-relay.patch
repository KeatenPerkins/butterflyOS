+ * input crosses the network; the synchronous GBA SIO bus stays in-process. */
+static bool butterflyInputRelayMode;
+static int butterflyInputSocket = -1;
+static uint32_t butterflyInputFrame;
+static bool butterflyInputFailed;
+static bool butterflyInputDiagnostics;
+static unsigned butterflyInputDiagnosticLines;
+static uint16_t butterflyLastLocalKeys;
+static uint16_t butterflyLastRemoteKeys;

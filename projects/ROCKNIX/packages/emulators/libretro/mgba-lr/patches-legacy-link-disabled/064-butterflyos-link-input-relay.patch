+/* The packet is intentionally small and fixed-width: one frame number and
+ * one mGBA joypad bitfield.  Both peers send before either waits to receive,
+ * so a TCP round trip cannot deadlock at the application level. */
+struct ButterflyInputPacket {
+	uint32_t frame;
+	uint16_t keys;
+} __attribute__((packed));
+
+static bool _linkWaitSocket(short events) {
+	struct pollfd descriptor = {
+		.fd = butterflyInputSocket,
+		.events = events,
+		.revents = 0,
+	};
+	int result;
+	do {
+		result = poll(&descriptor, 1, 10000);
+	} while (result < 0 && errno == EINTR);
+	return result > 0 && (descriptor.revents & events) &&
+	       !(descriptor.revents & (POLLERR | POLLHUP | POLLNVAL));
+}
+
+static bool _linkWriteInputPacket(const void* data, size_t size) {
+	const uint8_t* bytes = data;
+	size_t written = 0;
+	while (written < size) {
+		ssize_t result = send(butterflyInputSocket, bytes + written,
+		                      size - written, MSG_DONTWAIT | MSG_NOSIGNAL);
+		if (result > 0) {
+			written += (size_t) result;
+			continue;
+		}
+		if (result < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) {
+			if (!_linkWaitSocket(POLLOUT)) {
+				return false;
+			}
+			continue;
+		}
+		return false;
+	}
+	return true;
+}
+
+static bool _linkReadInputPacket(void* data, size_t size) {
+	uint8_t* bytes = data;
+	size_t read = 0;
+	while (read < size) {
+		if (!_linkWaitSocket(POLLIN)) {
+			return false;
+		}
+		ssize_t result = recv(butterflyInputSocket, bytes + read,
+		                      size - read, MSG_DONTWAIT);
+		if (result > 0) {
+			read += (size_t) result;
+			continue;
+		}
+		if (result < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) {
+			continue;
+		}
+		return false;
+	}
+	return true;
+}
+
+static bool _linkExchangeInputs(uint16_t localKeys, uint16_t* remoteKeys) {
+	struct ButterflyInputPacket outgoing = {
+		htonl(butterflyInputFrame),
+		htons(localKeys),
+	};
+	struct ButterflyInputPacket incoming;
+	if (!_linkWriteInputPacket(&outgoing, sizeof(outgoing)) ||
+	    !_linkReadInputPacket(&incoming, sizeof(incoming))) {
+		if (logCallback) {
+			logCallback(RETRO_LOG_ERROR,
+			           "[BFLink] input relay transport failed at frame=%u\\n",
+			           butterflyInputFrame);
+		}
+		return false;
+	}
+	uint32_t incomingFrame = ntohl(incoming.frame);
+	if (incomingFrame != butterflyInputFrame) {
+		if (logCallback) {
+			logCallback(RETRO_LOG_ERROR,
+			           "[BFLink] input relay frame mismatch local=%u remote=%u\\n",
+			           butterflyInputFrame, incomingFrame);
+		}
+		return false;
+	}
+	*remoteKeys = ntohs(incoming.keys);
+	if (butterflyInputDiagnostics && butterflyInputDiagnosticLines < 512 &&
+	    (!butterflyInputDiagnosticHaveKeys ||
+	     localKeys != butterflyLastLocalKeys ||
+	     *remoteKeys != butterflyLastRemoteKeys ||
+	     butterflyInputFrame < 120 || (butterflyInputFrame % 300) == 0)) {
+		if (logCallback) {
+			logCallback(RETRO_LOG_INFO,
+			           "[BFLink] input frame=%u player=%u local=0x%04X remote=0x%04X\\n",
+			           butterflyInputFrame, linkPlayer, localKeys, *remoteKeys);
+		}
+		butterflyLastLocalKeys = localKeys;
+		butterflyLastRemoteKeys = *remoteKeys;
+		butterflyInputDiagnosticHaveKeys = true;
+		++butterflyInputDiagnosticLines;
+	}
+	++butterflyInputFrame;
+	return true;
+}
+
 static int _linkUserRequestedId(struct mLockstepUser* user) {

+static void _diagnosticWords(struct GBASIOButterfly* link, uint32_t sequence,
+    uint16_t localWord, uint16_t remoteWord) {
+  if (!link->diagnostics || link->diagnosticWordLines >= 256) return;
+  if (link->diagnosticWordValid &&
+      link->diagnosticLastLocalWord == localWord &&
+      link->diagnosticLastRemoteWord == remoteWord) return;
+  link->diagnosticWordValid = true;
+  link->diagnosticLastLocalWord = localWord;
+  link->diagnosticLastRemoteWord = remoteWord;
+  ++link->diagnosticWordLines;
+  mLOG(GBA_SIO, INFO,
+      "BF word-change p=%u f=%u n=%u mode=%d seq=%u local=%04X remote=%04X",
+      link->playerId, link->diagnosticFrame, link->diagnosticWordLines,
+      link->d.p ? link->d.p->mode : -1, sequence, localWord, remoteWord);
+}

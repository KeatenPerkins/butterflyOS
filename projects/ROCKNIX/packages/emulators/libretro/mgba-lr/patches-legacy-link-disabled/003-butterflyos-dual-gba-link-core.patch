+static uint16_t _linkKeysForPort(unsigned port) {
+	uint16_t keys = 0;
+	int i;
+	if (useBitmasks) {
+		int16_t mask = inputCallback(port, RETRO_DEVICE_JOYPAD, 0,
+		                             RETRO_DEVICE_ID_JOYPAD_MASK);
+		for (i = 0; i < (int) (sizeof(keymap) / sizeof(*keymap)); ++i) {
+			keys |= ((mask >> keymap[i]) & 1) << i;
+		}
+	} else {
+		for (i = 0; i < (int) (sizeof(keymap) / sizeof(*keymap)); ++i) {
+			keys |= (!!inputCallback(port, RETRO_DEVICE_JOYPAD, 0,
+			                         keymap[i])) << i;
+		}
+	}
+	return keys;
+}

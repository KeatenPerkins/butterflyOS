+static bool _loadLinkSecondGame(const struct retro_game_info* game) {
+	struct VFile* rom;
+	if (game->data) {
+		linkData = anonymousMemoryMap(game->size);
+		if (!linkData) {
+			return false;
+		}
+		linkDataSize = game->size;
+		memcpy(linkData, game->data, game->size);
+		rom = VFileFromMemory(linkData, game->size);
+	} else {
+		linkData = NULL;
+		linkDataSize = 0;
+		rom = VFileOpen(game->path, O_RDONLY);
+	}
+	if (!rom) {
+		return false;
+	}
+
+	linkCore = mCoreFindVF(rom);
+	if (!linkCore || linkCore->platform(linkCore) != mPLATFORM_GBA) {
+		rom->close(rom);
+		return false;
+	}
+	mCoreInitConfig(linkCore, NULL);
+	linkCore->init(linkCore);
+	linkOutputBuffer = malloc(VIDEO_BUFF_SIZE);
+	if (!linkOutputBuffer) {
+		return false;
+	}
+	memset(linkOutputBuffer, 0xFF, VIDEO_BUFF_SIZE);
+	linkCore->setVideoBuffer(linkCore, linkOutputBuffer, VIDEO_WIDTH_MAX);
+	linkCore->loadROM(linkCore, rom);
+	linkSavedata = anonymousMemoryMap(GBA_SIZE_FLASH1M);
+	if (!linkSavedata) {
+		return false;
+	}
+	memset(linkSavedata, 0xFF, GBA_SIZE_FLASH1M);
+	return true;
+}

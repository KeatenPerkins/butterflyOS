+/* ButterflyOS: opt-in session defaults; explicit remaps still take priority. */
+#ifndef BUTTERFLYOS_SHARED_PLAYER1_H
+#define BUTTERFLYOS_SHARED_PLAYER1_H
+#include <stdlib.h>
+
+static unsigned butterflyos_default_game_port(unsigned port,
+      const unsigned *joypad_indices, unsigned max_users,
+      const char *builtin_index)
+{
+   char *end;
+   unsigned long builtin;
+   if (!builtin_index || !*builtin_index || port == 0 || port >= max_users)
+      return port;
+   if (*builtin_index < '0' || *builtin_index > '9')
+      return port;
+   builtin = strtoul(builtin_index, &end, 10);
+   if (*end || builtin >= max_users || joypad_indices[0] == builtin)
+      return port;
+   return joypad_indices[port] == builtin ? 0 : port;
+}
+#endif

#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Experimental branch only: permit explicit systemctl suspend but keep the
# legacy fake-suspend input path off. Tools owns opt-in lid triggering.
. /etc/profile.d/001-functions
mkdir -p /storage/.config/sleep.conf.d
# Every boot starts with manual testing; opt in to automatic lid sleep again.
rm -f /storage/.config/butterflyos/experimental-lid-suspend.enabled
cat > /storage/.config/sleep.conf.d/sleep.conf <<'CONF'
[Sleep]
AllowSuspend=yes
SuspendState=mem
CONF
set_setting system.suspendmode off
set_setting system.suspend.enable 0

#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Experimental branch only: permit explicit systemctl suspend but keep the
# legacy fake-suspend input path off. Tools owns lid triggering.
. /etc/profile.d/001-functions
mkdir -p /storage/.config/sleep.conf.d /storage/.config/logind.conf.d
# Only the experimental helper owns suspend requests. Otherwise logind's
# inherited lid policy would bypass the diagnostic tool and lid-enable marker.
cat > /storage/.config/logind.conf.d/90-butterflyos-experimental-suspend.conf <<'CONF'
[Login]
HandleLidSwitch=ignore
HandleLidSwitchExternalPower=ignore
HandleLidSwitchDocked=ignore
HandlePowerKey=ignore
HandlePowerKeyLongPress=ignore
CONF
# Candidate 2 defaults to lid sleep. A user's disable choice or a detected
# test failure stays disabled across boots until explicitly enabled in Tools.
mkdir -p /storage/.config/butterflyos
if [ -f /storage/.config/butterflyos/experimental-lid-suspend.disabled ]; then
  rm -f /storage/.config/butterflyos/experimental-lid-suspend.enabled
else
  touch /storage/.config/butterflyos/experimental-lid-suspend.enabled
fi
cat > /storage/.config/sleep.conf.d/sleep.conf <<'CONF'
[Sleep]
AllowSuspend=yes
SuspendState=mem
CONF
set_setting system.suspendmode off
set_setting system.suspend.enable 0

systemctl try-restart systemd-logind.service

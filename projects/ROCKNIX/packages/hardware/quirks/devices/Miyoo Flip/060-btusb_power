# RTL8733BU WiFi+BT combo chip — boot-time rfkill sync (Miyoo Flip).
#
# btusb is blacklisted in modprobe.d (udev auto-load at boot triggers a
# chip-level reset via btrtl firmware download before 8733bu has fully
# initialized the combo block, disconnecting the entire USB device).
# This quirk syncs rfkill state to the user's settings, and creates a
# bluetooth.service drop-in that explicitly loads btusb when BT is needed.

. /etc/profile.d/001-functions

# Keep runtime USB autosuspend disabled for the internal RTL8733BU combo
# device. It is normally already "on", but make that policy persistent across
# USB re-enumeration so a future default or userspace change cannot suspend the
# Wi-Fi/BT dongle underneath its vendor drivers.
mkdir -p /run/udev/rules.d
cat <<'EOF' >/run/udev/rules.d/70-miyoo-flip-rtl8733bu-power.rules
ACTION=="add|bind", SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="b733", TEST=="power/control", ATTR{power/control}="on"
EOF
udevadm control --reload 2>/dev/null || true
for usb_device in /sys/bus/usb/devices/*; do
  [ "$(cat "${usb_device}/idVendor" 2>/dev/null)" = 0bda ] || continue
  [ "$(cat "${usb_device}/idProduct" 2>/dev/null)" = b733 ] || continue
  [ -w "${usb_device}/power/control" ] && printf '%s\n' on >"${usb_device}/power/control"
done

if [ -e "/storage/.configured" ]; then
  WIFI_ENABLED=$(get_setting wifi.enabled)
  BT_ENABLED=$(get_setting controllers.bluetooth.enabled)
else
  WIFI_ENABLED=""
  BT_ENABLED=""
fi
if [ "${WIFI_ENABLED}" != "1" ]; then
  rfkill block wifi 2>/dev/null
fi

if [ "${BT_ENABLED}" != "1" ]; then
  rfkill block bluetooth 2>/dev/null
fi

# bluetooth.service drop-in: load btusb + wait for hci0 before bluetoothd,
# block BT rfkill on stop. btusb is blacklisted so this explicit modprobe
# is the ONLY way it gets loaded; once loaded it stays resident for the
# rest of the session (unloading it while WiFi is active kills the shared
# USB device). The rtl8733bu-power driver drops the chip GPIO when both
# wifi and bt rfkills are blocked, which cleanly disconnects the USB
# device and fires btusb/8733bu .disconnect callbacks automatically.
# /etc/ is read-only squashfs; use /run/systemd/system/ (tmpfs, writable).
OVERRIDE_DIR="/run/systemd/system/bluetooth.service.d"
OVERRIDE_FILE="${OVERRIDE_DIR}/70-btusb-miyoo-flip.conf"

mkdir -p "${OVERRIDE_DIR}"
cat <<'EOF' >"${OVERRIDE_FILE}.tmp"
[Service]
# bluetooth.service restricts CapabilityBoundingSet (no CAP_SYS_MODULE),
# so modprobe in ExecStartPre fails "Operation not permitted".
# Reset and re-add the original caps plus CAP_SYS_MODULE.
CapabilityBoundingSet=
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_FOWNER CAP_SYS_MODULE
ExecStartPre=-/usr/sbin/modprobe btusb
ExecStartPre=-/usr/sbin/rfkill unblock bluetooth
ExecStartPre=-/bin/sh -c 'i=0; while [ "$i" -lt 100 ]; do [ -e /sys/class/bluetooth/hci0 ] && exit 0; i=$((i+1)); sleep 0.05; done; exit 0'
ExecStopPost=-/usr/sbin/rfkill block bluetooth
EOF
if ! cmp -s "${OVERRIDE_FILE}.tmp" "${OVERRIDE_FILE}" 2>/dev/null; then
  mv "${OVERRIDE_FILE}.tmp" "${OVERRIDE_FILE}"
  systemctl daemon-reload
else
  rm -f "${OVERRIDE_FILE}.tmp"
fi

+void ControllerActivityComponent::updateBluetoothInfo()
+{
+	mBluetoothEnabled = false;
+
+	if ((mView & BLUETOOTH) == 0)
+		return;
+
+	for (int index = 0; index < 16; index++)
+	{
+		const std::string base = "/sys/class/rfkill/rfkill" + std::to_string(index) + "/";
+		std::ifstream typeFile(base + "type");
+		std::string type;
+		std::getline(typeFile, type);
+		if (type != "bluetooth")
+			continue;
+
+		std::ifstream stateFile(base + "state");
+		std::string state;
+		std::getline(stateFile, state);
+		if (state == "1")
+		{
+			mBluetoothEnabled = true;
+			return;
+		}
+	}
+}

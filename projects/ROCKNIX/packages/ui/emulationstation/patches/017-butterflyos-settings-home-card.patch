@@ -211,6 +211,17 @@ GuiMenu::GuiMenu(Window *window, bool animate) : GuiComponent(window), mMenu(win
 			ApiSystem::getInstance()->isScriptingSupported(ApiSystem::UPGRADE))
 			addEntry(_("UPDATES & DOWNLOADS"), true, [this] { openUpdatesSettings(); }, "iconUpdates");
 
+		// ButterflyOS presents Settings as a first-class home destination while
+		// keeping the complete Tools list available from the Start menu.
+		addEntry(_("TOOLS").c_str(), true, [this] {
+			SystemData* tools = SystemData::getSystem("tools");

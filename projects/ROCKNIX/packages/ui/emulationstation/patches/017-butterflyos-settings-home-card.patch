diff --git a/es-app/src/views/SystemView.cpp b/es-app/src/views/SystemView.cpp
index 2cc2a32..b750c62 100644
--- a/es-app/src/views/SystemView.cpp
+++ b/es-app/src/views/SystemView.cpp
@@ -478,6 +478,25 @@ bool SystemView::input(InputConfig* config, Input input)
 
 		if (config->isMappedTo(BUTTON_OK, input))
 		{
+			// Settings is a first-class home destination and mirrors the Start button.
+			if (getSelected() != nullptr && getSelected()->getName() == "settings")
+			{
+				mCarousel.stopScrolling();
+				// Use the same full menu Start opens. The compact Quick Access
+				// popup dismisses on the Flip's mapped input and only flashed here.
+				mWindow->pushGui(new GuiMenu(mWindow));
+				return true;
+			}
+
+			// Tools is also a first-class home destination. Open its script list
+			// directly, just as the Start-menu Tools entry does.
+			if (getSelected() != nullptr && getSelected()->getName() == "tools")
+			{
+				mCarousel.stopScrolling();
+				ViewController::get()->goToGameList(getSelected());
+				return true;
+			}
+
 			mCarousel.stopScrolling();
 			ViewController::get()->goToGameList(getSelected());
 			return true;

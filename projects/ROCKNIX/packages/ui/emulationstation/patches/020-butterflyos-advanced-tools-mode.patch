diff --git a/es-app/src/FileData.cpp b/es-app/src/FileData.cpp
index 6ece911..9ad149f 100644
--- a/es-app/src/FileData.cpp
+++ b/es-app/src/FileData.cpp
@@ -1077,6 +1077,18 @@ const std::vector<FileData*> FolderData::getChildrenListToDisplay()
 
 	for (auto it = items->cbegin(); it != items->cend(); it++)
 	{
+		// Keep recovery and technical launchers out of the normal ButterflyOS
+		// Tools view. Their metadata remains loaded, so toggling Advanced Mode
+		// can reveal them without moving files or rescanning storage.
+		if (mSystem->getName() == "tools" &&
+			SystemConf::getInstance()->get("ButterflyAdvancedMode") != "1" &&
+			(*it)->getMetadata(MetaDataId::Genre) != "Recovery" &&
+			(*it)->getName() != "System Manager" &&
+			(*it)->getName() != "Quick Start" &&
+			(*it)->getName() != "Controls Guide" &&
+			(*it)->getName() != "Prepare Game Card")
+			continue;
+
 		if (!showHiddenFiles && (*it)->getHidden())
 			continue;
 

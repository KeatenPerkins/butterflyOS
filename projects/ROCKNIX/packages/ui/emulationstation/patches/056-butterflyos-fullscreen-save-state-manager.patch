+void GuiSaveState::loadList()
+{
+    int selected = mList->getCursorIndex();
+    mEntries.clear();
+    mList->clear();
+    auto theme = ThemeData::getMenuTheme();
+    auto addLaunch = [this, theme](const std::string& label, SaveState* state)
+    {
+        ComponentListRow row;
+        row.addElement(std::make_shared<TextComponent>(mWindow, label, theme->Text.font, theme->Text.color), true);
+        mEntries.push_back(state);
+        mList->addRow(row);
+    };
+    addLaunch(_("START GAME"), mRepository->getDefaultNewGameSaveState());
+    auto states = mRepository->getSaveStates(mGame);
+    if (mRepository->supportsAutoSave() && mGame->getCurrentGameSetting("autosave") == "1")
+    {
+        auto autoSave = std::find_if(states.begin(), states.end(), [](SaveState* state) { return state->slot == -1; });
+        if (autoSave == states.end())
+            addLaunch(_("START GAME AUTO SAVE"), mRepository->getDefaultAutoSaveSaveState());
+    }
+    // Always show the newest real states first, including the automatic state.
+    std::stable_sort(states.begin(), states.end(), [](const SaveState* a, const SaveState* b)
+    {
+        return a->creationDate > b->creationDate;
+    });
+    size_t count = mShowAllStates ? states.size() : std::min(states.size(), size_t(3));
+    for (size_t i = 0; i < count; ++i)
+    {
+        auto state = states[i];
+        ComponentListRow row;
+        auto image = std::make_shared<ImageComponent>(mWindow);
+        float height = std::max(64.0f, theme->TextSmall.font->getHeight(3.0f));
+        image->setMaxSize(height * 1.5f, height);
+        auto screenshot = state->getScreenShot();
+        image->setImage(screenshot.empty() ? ":/freeslot.svg" : screenshot);
+        row.addElement(image, false);
+        std::string label = state->slot == -1 ? _("AUTO SAVE") : _("SLOT") + std::string(" ") + std::to_string(state->slot);
+        label += "\n" + state->creationDate.toLocalTimeString();
+        if (state->config != nullptr && !state->config->isActiveConfig(mGame))
+        {
+            label += "\n" + state->config->emulator;
+            if (!state->config->core.empty() && state->config->core != state->config->emulator)
+                label += ": " + state->config->core;
+        }
+        auto text = std::make_shared<TextComponent>(mWindow, label, theme->TextSmall.font, theme->Text.color,
+                                                    ALIGN_LEFT, Vector3f::Zero(), Vector2f(0, height));
+        row.addElement(text, true);
+        mEntries.push_back(state);
+        mList->addRow(row);
+    }
+    if (!mShowAllStates && states.size() > count)
+        addLaunch(_("MORE SAVE STATES"), nullptr);
+    else if (states.empty())
+    {
+        ComponentListRow row;
+        row.selectable = false;
+        row.addElement(std::make_shared<TextComponent>(mWindow, _("NO SAVE STATES YET"), theme->TextSmall.font, theme->Text.color), true);
+        mEntries.push_back(nullptr);
+        mList->addRow(row);
+    }
+    mList->setCursorIndex(std::min(selected, int(mEntries.size()) - 1));
+    updateHelpPrompts();
+}
+
+SaveState* GuiSaveState::selectedState() const
+{
+    int index = mList->getCursorIndex();
+    return index >= 0 && index < int(mEntries.size()) ? mEntries[index] : nullptr;
 }
 

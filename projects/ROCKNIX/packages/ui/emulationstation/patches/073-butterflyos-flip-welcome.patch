+void GuiMenu::openFlipWelcome(Window* window, int step)
+{
+    const std::string titles[] = {_("LANGUAGE"), _("TIME ZONE"), _("WI-FI"),
+                                  _("DEVICE NAME"), _("SSH PASSWORD"), _("RETROACHIEVEMENTS")};
+    auto page = new FlipWelcomePage(window, std::to_string(step + 1) + "/6  " + titles[step]);
+    auto error = [window](const std::string& message) { window->pushGui(new GuiMsgBox(window, message)); };
+    std::function<bool()> apply = [] { return true; };
+    if (step == 0)
+    {
+        page->addGroup(_("WELCOME TO BUTTERFLYOS"));
+        auto language_choice = std::make_shared<OptionListComponent<std::string>>(window, _("LANGUAGE"), false);
+        std::string language = SystemConf::getInstance()->get("system.language");
+        if (language.empty()) language = "en_US";
+	language_choice->add("العربية",               "ar_YE", language == "ar_YE");

+class FlipWelcomePage : public GuiSettings
+{
+public:
+    FlipWelcomePage(Window* window, const std::string& title) : GuiSettings(window, title) {}
+
+    void setActions(const std::string& nextLabel, const std::function<void()>& next,
+                    const std::function<void()>& back, const std::function<void()>& skip)
+    {
+        mBack = back;
+        mMenu.clearButtons();
+        mMenu.addButton(_("BACK"), _("BACK"), back);
+        mMenu.addButton(_("SKIP ALL"), _("SKIP ALL"), skip);
+        mMenu.addButton(nextLabel, nextLabel, next);
+        mMenu.setCursorToList();
+    }
+
+    bool input(InputConfig* config, Input input) override
+    {
+        if (config->isMappedTo(BUTTON_BACK, input))
+        {
+            if (input.value && mBack) mBack();
+            return true;
+        }
+        return GuiSettings::input(config, input);
+    }
+
+private:
+    std::function<void()> mBack;
+};

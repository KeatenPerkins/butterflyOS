+	language_choice->add("ČEŠTINA",                "cs_CZ", language == "cs_CZ");
+	language_choice->add("CYMRAEG",              "cy_GB", language == "cy_GB");
+	language_choice->add("DEUTSCH", 	     "de_DE", language == "de_DE");
+	language_choice->add("ΕΛΛΗΝΙΚΆ",                "el_GR", language == "el_GR");
+	language_choice->add("ENGLISH (US)", 	     "en_US", language == "en_US" || language == "en");
+	language_choice->add("ENGLISH (UK)", 	     "en_GB", language == "en_GB");
+	language_choice->add("ESPAÑOL", 	     "es_ES", language == "es_ES" || language == "es");
+	language_choice->add("ESPAÑOL MEXICANO",     "es_MX", language == "es_MX");
+	language_choice->add("EUSKARA",               "eu_ES", language == "eu_ES");
+	language_choice->add("SUOMI",                "fi_FI", language == "fi_FI");
+	language_choice->add("FRANÇAIS",             "fr_FR", language == "fr_FR" || language == "fr");
+	language_choice->add("GALEGO",               "gl_ES", language == "gl_ES");
+	language_choice->add("עברית",                "he_IL", language == "he_IL");
+	language_choice->add("HRVATSKI",            "hu_HU", language == "hu_HU");
+	language_choice->add("BAHASA INDONESIA",     "id_ID", language == "id_ID");
+	language_choice->add("ITALIANO",             "it_IT", language == "it_IT");
+	language_choice->add("日本語", 	     "ja_JP", language == "ja_JP");
+	language_choice->add("한국어",   	     "ko_KR", language == "ko_KR" || language == "ko");
+	language_choice->add("NORSK BOKMÅL",     "nb_NO", language == "nb_NO");
+	language_choice->add("NEDERLANDS",                "nl_NL", language == "nl_NL");
+	language_choice->add("NORSK NYNORSK",            "nn_NO", language == "nn_NO");
+	language_choice->add("OCCITAN",              "oc_FR", language == "oc_FR");
+	language_choice->add("POLSKI",               "pl_PL", language == "pl_PL");
+	language_choice->add("PORTUGUÊS BRASILEIRO", "pt_BR", language == "pt_BR");
+	language_choice->add("PORTUGUÊS",   "pt_PT", language == "pt_PT");
+	language_choice->add("ROMÂNĂ",               "ro_RO", language == "ro_RO");
+	language_choice->add("РУССКИЙ",              "ru_RU", language == "ru_RU");
+	language_choice->add("SLOVENČINA", 	     "sk_SK", language == "sk_SK");
+	language_choice->add("SVENSKA", 	     "sv_SE", language == "sv_SE");
+	language_choice->add("TÜRKÇE",  	     "tr_TR", language == "tr_TR");
+	language_choice->add("УКРАЇНСЬКА",           "uk_UA", language == "uk_UA");
+	language_choice->add("TIẾNG VIỆT",           "vi_VN", language == "vi_VN");
+	language_choice->add("简体中文", 	     "zh_CN", language == "zh_CN");
+	language_choice->add("正體中文", 	     "zh_TW", language == "zh_TW");
+
+        if (!language_choice->hasSelection()) language_choice->selectFirstItem();
+        page->addWithLabel(_("LANGUAGE"), language_choice);
+        apply = [language_choice] {
+            auto language = language_choice->getSelected();
+            SystemConf::getInstance()->set("system.language", language);
+            EsLocale::changeLocale(language);
+            FileSorts::reset();
+            MetaDataList::initMetadata();
+            return true;
+        };
+    }
+    else if (step == 1)
+    {
+        page->addGroup(_("CHOOSE REGION, COUNTRY AND CITY"));
+        auto regions = std::make_shared<OptionListComponent<std::string>>(window, _("REGION"), false);
+        auto countries = std::make_shared<OptionListComponent<std::string>>(window, _("COUNTRY"), false);
+        auto choices = std::make_shared<OptionListComponent<std::string>>(window, _("CITY / TIME ZONE"), false);
+        auto current = SystemConf::getInstance()->get("system.timezone");
+        if (current.empty()) current = Utils::Platform::GetShOutput("/usr/bin/timeinfo current_timezone");
+        auto trim = [](std::string value) {
+            auto start = value.find_first_not_of(" \t\r\n");
+            return start == std::string::npos ? std::string() : value.substr(start, value.find_last_not_of(" \t\r\n") - start + 1);
+        };
+        current = trim(current);
+        if (current.empty() || current.find("..") != std::string::npos ||
+            !Utils::FileSystem::exists("/usr/share/zoneinfo/" + current)) current = "UTC";
+        auto regionFor = [](const std::string& zone) -> std::string {
+            auto prefix = zone.substr(0, zone.find('/'));
+            if (prefix == "America") return "Americas";
+            if (prefix == "Europe" || prefix == "Asia" || prefix == "Africa") return prefix;
+            if (prefix == "Australia" || prefix == "Pacific") return "Oceania";
+            if (prefix == "Etc" || zone == "UTC" || zone == "GMT") return "UTC";
+            return "Other";
+        };
+        auto labelFor = [](std::string zone) {
+            const std::map<std::string, std::string> familiar = {
+                {"America/Chicago", "Chicago - Central Time"},
+                {"America/New_York", "New York - Eastern Time"},
+                {"America/Denver", "Denver - Mountain Time"},
+                {"America/Los_Angeles", "Los Angeles - Pacific Time"},
+                {"America/Anchorage", "Anchorage - Alaska Time"},
+                {"Pacific/Honolulu", "Honolulu - Hawaii Time"},
+                {"UTC", "UTC - Coordinated Universal Time"}
+            };
+            auto familiarName = familiar.find(zone);
+            if (familiarName != familiar.end()) return familiarName->second;
+            std::replace(zone.begin(), zone.end(), '_', ' ');
+            auto slash = zone.find('/');
+            if (slash == std::string::npos) return zone;
+            auto city = zone.substr(slash + 1);
+            auto subregion = city.find_last_of('/');
+            if (subregion != std::string::npos)
+                city = city.substr(subregion + 1) + " (" + city.substr(0, subregion) + ")";
+            return city;
+        };
+        std::map<std::string, std::string> countryNames;
+        std::ifstream names("/usr/share/zoneinfo/iso3166.tab");
+        std::string line;
+        while (std::getline(names, line))
+        {
+            if (line.empty() || line.front() == '#') continue;
+            auto tab = line.find('\t');
+            if (tab != std::string::npos) countryNames[line.substr(0, tab)] = trim(line.substr(tab + 1));
+        }
+        countryNames["UTC"] = _("UTC / NO COUNTRY");
+        countryNames["ZZ"] = _("OTHER / UNASSIGNED");
+        std::vector<std::pair<std::string, std::string>> zones;
+        std::map<std::string, std::vector<std::string>> zoneCountries;
+        std::ifstream table("/usr/share/zoneinfo/zone.tab");
+        if (!table.is_open()) table.open("/usr/share/zoneinfo/zone1970.tab");
+        while (std::getline(table, line))
+        {
+            if (line.empty() || line.front() == '#') continue;
+            std::stringstream row(line);
+            std::string codes, coordinates, zone, code;
+            if (!std::getline(row, codes, '\t') || !std::getline(row, coordinates, '\t') || !std::getline(row, zone, '\t')) continue;
+            zone = trim(zone);
+            if (zone.empty()) continue;
+            zones.emplace_back(labelFor(zone), zone);
+            for (std::stringstream list(codes); std::getline(list, code, ','); )
+                zoneCountries[zone].push_back(code);
+        }
+        for (const auto& zone : {current, std::string("UTC")})
+            if (std::none_of(zones.begin(), zones.end(), [&zone](const auto& item) { return item.second == zone; }))
+            {
+                zones.emplace_back(labelFor(zone), zone);
+                auto canonical = Utils::FileSystem::getCanonicalPath("/usr/share/zoneinfo/" + zone);
+                const std::string prefix = "/usr/share/zoneinfo/";
+                if (canonical.find(prefix) == 0) canonical = canonical.substr(prefix.size());
+                auto found = zoneCountries.find(canonical);
+                zoneCountries[zone] = regionFor(zone) == "UTC" ? std::vector<std::string>{"UTC"} :
+                    found != zoneCountries.end() ? found->second : std::vector<std::string>{"ZZ"};
+            }
+        const auto currentCountry = zoneCountries.at(current).front();
+        std::sort(zones.begin(), zones.end());
+        const std::vector<std::pair<std::string, std::string>> regionNames = {
+            {_("AMERICAS"), "Americas"}, {_("EUROPE"), "Europe"}, {_("ASIA"), "Asia"},
+            {_("AFRICA"), "Africa"}, {_("OCEANIA"), "Oceania"}, {_("UTC"), "UTC"},
+            {_("OTHER REGIONS / OCEANS"), "Other"}
+        };
+        for (const auto& region : regionNames)
+            if (std::any_of(zones.begin(), zones.end(), [&region, regionFor](const auto& zone) { return regionFor(zone.second) == region.second; }))
+                regions->add(region.first, region.second, region.second == regionFor(current));
+        auto populateCities = [choices, zones, zoneCountries, current](const std::string& country) {
+            choices->clear();
+            for (const auto& zone : zones)
+            {
+                const auto& codes = zoneCountries.at(zone.second);
+                if (std::find(codes.begin(), codes.end(), country) != codes.end())
+                    choices->add(zone.first, zone.second, zone.second == current);
+            }
+            if (!choices->hasSelection()) choices->selectFirstItem();
+            choices->invalidate();
+        };
+        auto populateCountries = [countries, zones, zoneCountries, countryNames, regionFor, currentCountry, populateCities](const std::string& region) {
+            std::map<std::string, std::string> available;
+            for (const auto& zone : zones)
+                if (regionFor(zone.second) == region)
+                    for (const auto& code : zoneCountries.at(zone.second))
+                    {
+                        auto name = countryNames.find(code);
+                        available[code] = name == countryNames.end() ? code : name->second;
+                    }
+            std::vector<std::pair<std::string, std::string>> sorted;
+            for (const auto& country : available) sorted.emplace_back(country.second, country.first);
+            std::sort(sorted.begin(), sorted.end());
+            countries->clear();
+            for (const auto& country : sorted)
+                countries->add(country.first, country.second, country.second == currentCountry);
+            if (!countries->hasSelection()) countries->selectFirstItem();
+            countries->invalidate();
+            populateCities(countries->getSelected());
+        };
+        populateCountries(regions->getSelected());
+        countries->setSelectedChangedCallback([populateCities](std::string country) { populateCities(country); });
+        regions->setSelectedChangedCallback([populateCountries](std::string region) { populateCountries(region); });
+        page->addWithLabel(_("REGION"), regions);
+        page->addWithLabel(_("COUNTRY"), countries);
+        page->addWithLabel(_("CITY / TIME ZONE"), choices);
+        apply = [choices, error] {
+            auto zone = choices->getSelected();
+            std::string target = "/usr/share/zoneinfo/" + zone;
+            if (!Utils::FileSystem::exists(target) || std::system(("ln -sfn " + Utils::String::shellQuote(target) + " /var/run/localtime").c_str()) != 0)
+            { error(_("COULD NOT APPLY THE TIME ZONE. PLEASE TRY AGAIN.")); return false; }
+            SystemConf::getInstance()->set("system.timezone", zone);
+            return true;
+        };
+    }
+    else if (step == 2)
+    {
+        page->addGroup(_("CONNECT NOW OR CHOOSE NEXT TO STAY OFFLINE"));
+        page->addEntry(_("SELECT WI-FI NETWORK"), true, [window] {
+            window->pushGui(new GuiLoading<bool>(window, _("STARTING WI-FI..."), [](auto) {
+                return std::system("/usr/bin/wifictl enable") == 0;
+            }, [window](bool ready) {
+                if (ready)
+                {
+                    SystemConf::getInstance()->setBool("wifi.enabled", true);
+                    SystemConf::getInstance()->saveSystemConf();
+                    openWifiSettings(window, _("SELECT WI-FI NETWORK"), SystemConf::getInstance()->get("wifi.ssid"),
+                        [](std::string) {}, true);
+                }
+                else window->pushGui(new GuiMsgBox(window, _("COULD NOT ENABLE WI-FI. RETRY OR CONTINUE OFFLINE.")));
+            }));
+        });
+    }
+    else if (step == 3)
+    {
+        auto hostname = std::make_shared<std::string>(SystemConf::getInstance()->get("system.hostname"));
+        if (hostname->empty()) *hostname = "butterflyos";
+        page->addInputTextRow(_("DEVICE NAME"), *hostname, false, nullptr,
+            [hostname](std::string value) { *hostname = value; });
+        apply = [hostname, error] {
+            const auto& name = *hostname;
+            auto alnum = [](char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'); };
+            if (name.empty() || name.size() > 63 || !alnum(name.front()) || !alnum(name.back()) ||
+                !std::all_of(name.begin(), name.end(), [alnum](char c) { return alnum(c) || c == '-'; }))
+            {
+                error(_("USE LETTERS, NUMBERS OR HYPHENS. BEGIN AND END WITH A LETTER OR NUMBER."));
+                return false;
+            }
+            if (sethostname(name.c_str(), name.size()) != 0)
+            {
+                error(_("COULD NOT SET DEVICE NAME."));
+                return false;
+            }
+            SystemConf::getInstance()->set("system.hostname", name);
+            return true;
+        };
+    }
+    else if (step == 4)
+    {
+        page->addGroup(_("OPTIONAL - SSH USERNAME: ROOT"));
+        addWebTransferPassword(page, _("SET DEVICE PASSWORD"));
+        page->addGroup(_("ENABLE SSH LATER IN NETWORK SETTINGS"));
+    }
+    else
+    {
+        page->addGroup(_("OPTIONAL - SET UP YOUR RETROACHIEVEMENTS ACCOUNT"));
+        page->addEntry(_("RETROACHIEVEMENTS LOGIN"), true, [window] {
+            window->pushGui(new GuiRetroAchievementsSettings(window));
+        });
+    }
+
+    // Defer navigation until the button callback has returned.
+    auto navigate = [window, page](int next) {
+        window->postToUiThread([window, page, next] {
+            if (window->peekGui() != page) return;
+            page->close();
+            if (next >= 0)
+                openFlipWelcome(window, next);
+            else
+            {
+                SystemConf::getInstance()->set("butterflyos.flip.welcome.completed", "1");
+                if (SystemConf::getInstance()->saveSystemConf())
+                    std::remove(flipWelcomePending);
+            }
+        });
+    };
+    page->setActions(step == 5 ? _("FINISH") : _("NEXT"), [apply, navigate, step] {
+        if (!apply()) return;
+        SystemConf::getInstance()->saveSystemConf();
+        navigate(step == 5 ? -1 : step + 1);
+    }, [navigate, step] { if (step > 0) navigate(step - 1); },
+       [navigate] { navigate(-1); });
+    page->updateSize();
+    window->pushGui(page);
 }
 

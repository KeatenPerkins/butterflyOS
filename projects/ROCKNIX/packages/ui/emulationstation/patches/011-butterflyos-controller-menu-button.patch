+void GuiControllersSettings::update(int deltaTime)
+{
+	GuiSettings::update(deltaTime);
+
+	mControllerRefreshTimer += deltaTime;
+	if (mControllerRefreshTimer < 500)
+		return;
+	mControllerRefreshTimer = 0;
+
+	bool connected = false;
+	for (auto controller : InputManager::getInstance()->getInputConfigs())
+		if (controller->getDeviceName() != "retrogame_joypad")
+			connected = true;
+
+	if (connected != mExternalControllerConnected)
+	{
+		Window* parent = mWindow;
+		setSave(false);
+		delete this;
+		openControllersSettings(parent);
+		return;
+	}
+}

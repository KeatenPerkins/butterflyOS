+void CollectionSystemManager::syncFavoriteFromRetroArch(FileData* file)
+{
+	if (file == nullptr || file->getType() != GAME)
+		return;
+
+	auto sourceFile = file->getSourceFileData();
+	auto sourceSystem = sourceFile->getSystem();
+	if (sourceSystem == nullptr)
+		return;
+
+	bool favorite = ButterflyFavorites::contains(sourceFile->getFullPath());
+	bool wasFavorite = sourceFile->getMetadata(MetaDataId::Favorite) == "true";
+	if (favorite == wasFavorite)
+		return;
+
+	sourceSystem->removeFromIndex(sourceFile);
+	sourceFile->setMetadata(MetaDataId::Favorite, favorite ? "true" : "false");
+	sourceSystem->addToIndex(sourceFile);
+	saveToGamelistRecovery(sourceFile);
+	refreshCollectionSystems(sourceFile);
+
+	auto view = ViewController::get()->getGameListView(sourceSystem, false);
+	if (view != nullptr && view->hasFileDataEntry(sourceFile))
+		view->onFileChanged(sourceFile, FILE_METADATA_CHANGED);
+}

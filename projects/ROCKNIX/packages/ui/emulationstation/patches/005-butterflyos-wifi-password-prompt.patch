--- a/es-app/src/guis/GuiMenu.cpp
+++ b/es-app/src/guis/GuiMenu.cpp
@@ -5390,7 +5390,29 @@ std::vector<std::pair<std::string, std::string>> getCountryCodes()
 
 void GuiMenu::openWifiSettings(Window* win, std::string title, std::string data, const std::function<void(std::string)>& onsave)
 {
-	win->pushGui(new GuiWifi(win, title, data, onsave));
+	win->pushGui(new GuiWifi(win, title, data, [win, onsave](const std::string& ssid)
+	{
+		const std::string previousSSID = SystemConf::getInstance()->get("wifi.ssid");
+		const std::string currentKey = previousSSID == ssid ? SystemConf::getInstance()->get("wifi.key") : "";
+
+		// GuiWifi invokes this callback before closing itself. Queue the password
+		// editor so it opens after the network list has safely left the GUI stack.
+		win->postToUiThread([win, ssid, currentKey, onsave]
+		{
+			auto saveKey = [ssid, onsave](const std::string& key)
+			{
+				onsave(ssid);
+				SystemConf::getInstance()->set("wifi.ssid", ssid);
+				SystemConf::getInstance()->set("wifi.key", key);
+			};
+			const std::string passwordTitle = std::string(_("WI-FI PASSWORD")) + ": " + ssid;
+
+			if (Settings::getInstance()->getBool("UseOSK"))
+				win->pushGui(new GuiTextEditPopupKeyboard(win, passwordTitle, currentKey, saveKey, false));
+			else
+				win->pushGui(new GuiTextEditPopup(win, passwordTitle, currentKey, saveKey, false));
+		});
+	}));
 }
 

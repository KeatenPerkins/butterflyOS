+static void addWebTransferPassword(GuiSettings* s, const std::string& label)
+{
+	auto editSshPassword = [](Window* win, std::string title, std::string currentPassword,
+		const std::function<void(std::string)>& onsave)
+	{
+		auto applyPassword = [win, onsave](const std::string& newPassword)
+		{
+			if (newPassword.empty())
+			{
+				win->pushGui(new GuiMsgBox(win, _("PASSWORD CANNOT BE EMPTY.")));
+				return;
+			}
+
+			if (std::system(("setrootpass " + Utils::String::shellQuote(newPassword)).c_str()) != 0)
+			{
+				win->pushGui(new GuiMsgBox(win, _("COULD NOT UPDATE THE DEVICE PASSWORD.")));
+				return;
+			}
+			onsave(newPassword);
+			SystemConf::getInstance()->saveSystemConf();
+			win->pushGui(new GuiMsgBox(win, _("DEVICE PASSWORD UPDATED. THIS ALSO CHANGES SSH LOGIN.")));
+		};
+
+		// Never put the existing password back into the editor. This prevents an
+		// accidental suffix and makes it clear that this action sets a new value.
+		if (Settings::getInstance()->getBool("UseOSK"))
+			win->pushGui(new GuiTextEditPopupKeyboard(win, title, "", applyPassword, false, "OK", true));
+		else
+			win->pushGui(new GuiTextEditPopup(win, title, "", applyPassword, false));
+	};
+	s->addInputTextConfigRow(label, "root.password", true, false, editSshPassword);
+}
+
+static void addWebTransferControls(GuiSettings* s, Window* window)
+{
+	auto toggle = std::make_shared<SwitchComponent>(window);
+	toggle->setState(std::system("systemctl is-active --quiet simple-http-server") == 0);
+	s->addWithDescription(_("WEB FILE TRANSFER"), _("Browse and upload games or media from your local network."), toggle);
+
+	const auto ip = ApiSystem::getInstance()->getIpAddress();
+	auto theme = ThemeData::getMenuTheme();
+	auto address = std::make_shared<TextComponent>(window,
+		ip.empty() || ip == "0.0.0.0" ? _("NOT CONNECTED") : "http://" + ip,
+		theme->Text.font, theme->Text.color);
+	s->addWithDescription(_("WEB ADDRESS"), _("Sign in as root with your device password."), address);
+
+	toggle->setOnChangedCallback([control = toggle.get(), window, restoring = std::make_shared<bool>(false)] {
+		if (*restoring)
+			return;
+		const bool enabled = control->getState();
+		const auto password = SystemConf::getInstance()->get("root.password");
+		std::string error;
+		if (enabled && (password.empty() || password == "rocknix"))
+			error = _("SET A DEVICE PASSWORD BEFORE ENABLING WEB FILE TRANSFER.");
+		else if (std::system(enabled ? "systemctl enable --now simple-http-server" :
+			"systemctl disable --now simple-http-server") != 0)
+			error = _("COULD NOT CHANGE WEB FILE TRANSFER. PLEASE TRY AGAIN.");
+
+		if (!error.empty())
+		{
+			*restoring = true;
+			control->setState(!enabled);
+			*restoring = false;
+			window->pushGui(new GuiMsgBox(window, error));
+			return;
+		}
+		SystemConf::getInstance()->set("simplehttp.enabled", enabled ? "1" : "0");
+		SystemConf::getInstance()->saveSystemConf();
+	});
+}
+
+void GuiMenu::openWebTransferTool(Window* window)
+{
+	auto menu = new GuiSettings(window, _("WEB FILE TRANSFER"));
+	addWebTransferPassword(menu, _("SET OR CHANGE DEVICE PASSWORD"));
+	addWebTransferControls(menu, window);
+	menu->updateSize();
+	window->pushGui(menu);
+}

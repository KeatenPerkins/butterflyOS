# Minimal OS variable loading for performance
. /etc/profile.d/001-functions

# ROCKNIX discovers themes through writable theme directories, rather than
# /usr/share/themes. Register the packaged variant without replacing a user's
# custom theme of the same name. The existing system-theme remains the default.
white_theme="/usr/share/themes/ButterflyOS White"
white_link="/storage/.config/emulationstation/themes/ButterflyOS White"
if [ -f "${white_theme}/theme.xml" ] && [ ! -e "${white_link}" ] && [ ! -L "${white_link}" ]; then
  mkdir -p /storage/.config/emulationstation/themes
  ln -s "${white_theme}" "${white_link}"
fi

if [ ! -L "/storage/.emulationstation" ] && \
   [ -d /storage/.config/emulationstation ]
then
  ln -sf /storage/.config/emulationstation /storage/.emulationstation
fi


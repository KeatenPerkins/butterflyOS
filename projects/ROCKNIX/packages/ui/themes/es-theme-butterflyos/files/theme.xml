<theme defaultTransition="instant">
  <formatVersion>7</formatVersion>

  <variables>
    <fontRegular>/usr/share/fonts/liberation/LiberationSans-Regular.ttf</fontRegular>
    <fontBold>/usr/share/fonts/liberation/LiberationSans-Bold.ttf</fontBold>
  </variables>

  <!-- Keep global status indicators inside the Flip's visible safe area. -->
  <view name="screen">
    <text name="clock">
      <origin>0 0</origin>
      <pos>0.035 0.035</pos>
      <size>0.18 0.055</size>
      <fontPath>${fontBold}</fontPath>
      <fontSize>0.033333</fontSize>
      <alignment>left</alignment>
      <color>d9e7ffff</color>
    </text>
    <batteryIndicator name="batteryIndicator">
      <pos>0.735 0.035</pos>
      <size>0.23 0.055</size>
      <horizontalAlignment>right</horizontalAlignment>
      <color>d9e7ffff</color>
    </batteryIndicator>
  </view>

  <view name="system,basic,detailed,grid,video">
    <image name="butterfly-background" extra="true">
      <origin>0 0</origin>
      <pos>0 0</pos>
      <size>1 1</size>
      <path>./assets/background.svg</path>
      <zIndex>-10</zIndex>
    </image>
    <helpsystem name="help">
      <origin>0.5 0.5</origin>
      <pos>0.5 0.945</pos>
      <textColor>d9e7ffff</textColor>
      <iconColor>ffffffff</iconColor>
      <fontPath>${fontBold}</fontPath>
      <fontSize>0.033333</fontSize>
    </helpsystem>
  </view>

  <view name="system">
    <text name="systemInfo">
      <visible>false</visible>
    </text>
    <carousel name="systemcarousel">
      <origin>0 0</origin>
      <pos>0.035 0.1475</pos>
      <size>0.64 0.58</size>
      <type>vertical</type>
      <logoSize>0.55 0.105</logoSize>
      <logoScale>1</logoScale>
      <logoAlignment>center</logoAlignment>
      <maxLogoCount>4</maxLogoCount>
      <minLogoOpacity>1</minLogoOpacity>
      <color>00000000</color>
      <defaultTransition>instant</defaultTransition>
      <zIndex>5</zIndex>
    </carousel>
    <!--
      Resolve in order: generic fallback, physical system art, then a compact
      home-menu icon and label. Missing paths are ignored by ThemeData.
    -->
    <image name="logo">
      <path>./assets/systems/_default.png</path>
      <path>./assets/systems/${system.theme}.png</path>
      <path>./assets/menu/${system.theme}.png</path>
    </image>
    <text name="logoText">
      <fontPath>${fontBold}</fontPath>
      <fontSize>0.0479167</fontSize>
      <forceUppercase>false</forceUppercase>
      <alignment>center</alignment>
      <verticalAlignment>center</verticalAlignment>
      <color>ffffffff</color>
      <zIndex>6</zIndex>
    </text>
    <image name="butterfly-brand" extra="true">
      <origin>0.5 0</origin>
      <pos>0.5 0.025</pos>
      <maxSize>0.30 0.15</maxSize>
      <path>./assets/butterflyos-logo.png</path>
      <zIndex>3</zIndex>
    </image>
    <!-- Four stationary row frames make the carousel read like a console menu. -->
    <rectangle name="menu-row-1" extra="true">
      <pos>0.055 0.245</pos><size>0.60 0.105</size>
      <color>110b1fcc</color><borderColor>7c4dffff</borderColor>
      <borderSize>0.0046875</borderSize><roundCorners>0.018</roundCorners><zIndex>2</zIndex>
    </rectangle>
    <rectangle name="menu-row-2" extra="true">
      <pos>0.055 0.385</pos><size>0.60 0.105</size>
      <color>102849ee</color><borderColor>159dffff</borderColor>
      <borderSize>0.00625</borderSize><roundCorners>0.018</roundCorners><zIndex>3</zIndex>
    </rectangle>
    <rectangle name="menu-row-3" extra="true">
      <pos>0.055 0.525</pos><size>0.60 0.105</size>
      <color>110b1fcc</color><borderColor>7c4dffff</borderColor>
      <borderSize>0.0046875</borderSize><roundCorners>0.018</roundCorners><zIndex>2</zIndex>
    </rectangle>
    <rectangle name="menu-row-4" extra="true">
      <pos>0.055 0.665</pos><size>0.60 0.105</size>
      <color>110b1fcc</color><borderColor>7c4dffff</borderColor>
      <borderSize>0.0046875</borderSize><roundCorners>0.018</roundCorners><zIndex>2</zIndex>
    </rectangle>
  </view>

  <view name="basic,detailed">
    <image name="background">
      <visible>false</visible>
    </image>
    <image name="logo">
      <visible>false</visible>
    </image>
    <text name="logoText">
      <origin>0 0.5</origin>
      <pos>0.055 0.105</pos>
      <size>0.89 0.1</size>
      <fontPath>${fontBold}</fontPath>
      <fontSize>0.058333</fontSize>
      <forceUppercase>true</forceUppercase>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <color>ffffffff</color>
      <zIndex>5</zIndex>
    </text>
    <textlist name="gamelist">
      <origin>0 0</origin>
      <pos>0.045 0.205</pos>
      <size>0.47 0.65</size>
      <fontPath>${fontBold}</fontPath>
      <fontSize>0.045833</fontSize>
      <lines>7</lines>
      <alignment>left</alignment>
      <selectorColor>5636aacc</selectorColor>
      <selectedColor>ffffffff</selectedColor>
      <primaryColor>b9c4d6ff</primaryColor>
      <secondaryColor>b9c4d6ff</secondaryColor>
      <scrollbarColor>10d9ff88</scrollbarColor>
      <scrollbarSize>0.00625</scrollbarSize>
      <zIndex>5</zIndex>
    </textlist>
  </view>

  <view name="basic">
    <textlist name="gamelist">
      <size>0.91 0.65</size>
      <alignment>center</alignment>
    </textlist>
  </view>

  <view name="detailed">
    <text name="md_lbl_rating,md_lbl_developer,md_developer,md_lbl_publisher,md_publisher,md_lbl_playcount,md_playcount,md_lbl_lastplayed,md_lbl_players,md_players,md_lbl_releasedate,md_lbl_genre,md_genre,md_description,md_name,md_lbl_gametime,md_gametime">
      <visible>false</visible>
    </text>
    <datetime name="md_releasedate,md_lastplayed">
      <visible>false</visible>
    </datetime>
    <rating name="md_rating">
      <visible>false</visible>
    </rating>
    <image name="md_image">
      <visible>false</visible>
    </image>
    <image name="game-card" extra="true">
      <origin>0.5 0.5</origin>
      <pos>0.75 0.49</pos>
      <size>0.43 0.56</size>
      <path>./assets/card.svg</path>
      <zIndex>2</zIndex>
    </image>
    <image name="game-artwork" extra="true">
      <origin>0.5 0.5</origin>
      <pos>0.75 0.475</pos>
      <maxSize>0.36 0.46</maxSize>
      <path>{game:image}</path>
      <roundCorners>0.018</roundCorners>
      <zIndex>4</zIndex>
    </image>
    <text name="no-artwork" extra="true">
      <origin>0.5 0.5</origin>
      <pos>0.75 0.475</pos>
      <size>0.32 0.15</size>
      <text>NO ARTWORK</text>
      <fontPath>${fontBold}</fontPath>
      <fontSize>0.033333</fontSize>
      <alignment>center</alignment>
      <verticalAlignment>center</verticalAlignment>
      <color>7b8496ff</color>
      <zIndex>3</zIndex>
    </text>
  </view>
</theme>
